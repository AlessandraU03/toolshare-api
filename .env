# =============================================================================
# Configuración del servidor
# =============================================================================
SERVER_PORT=8080

# =============================================================================
# Base de datos PostgreSQL
# Formato: postgres://usuario:contraseña@host:puerto/nombre_db?sslmode=disable
# =============================================================================
DATABASE_URL=postgres://postgres:secret@100.50.210.8:5432/tool_inventory?sslmode=disable

# =============================================================================
# JWT - Clave secreta para firmar tokens
# En producción usa una cadena aleatoria larga (mínimo 32 caracteres)
# =============================================================================
JWT_SECRET=UnAcAdEnAaLeAtOrIaYSeGuRaDeMaYaSDe32ChArS

# Duración del token JWT (ejemplos: 24h, 48h, 168h)
JWT_EXPIRATION=24h

# =============================================================================
# URL base del servidor (usada para construir URLs de fotos subidas)
# =============================================================================
BASE_URL=http://0.0.0.0:8080

# =============================================================================
# Mercado Pago — dejar vacío para usar URL simulada en desarrollo
# En producción: URL de tu preferencia de pago MP con capture_mode: manual
# =============================================================================
MERCADO_PAGO_CHECKOUT_URL=