# =============================================================================
# Configuración del servidor
# =============================================================================
SERVER_PORT=8080

# =============================================================================
# Base de datos PostgreSQL
# Formato: postgres://usuario:contraseña@host:puerto/nombre_db?sslmode=disable
# =============================================================================
DATABASE_URL=postgres://ale:lagartija@localhost:5432/tool_inventory?sslmode=disable

# =============================================================================
# JWT - Clave secreta para firmar tokens
# En producción usa una cadena aleatoria larga (mínimo 32 caracteres)
# =============================================================================
JWT_SECRET=UnAcAdEnAaLeAtOrIaYSeGuRaDeMaYaSDe32ChArS

# Duración del token JWT (ejemplos: 24h, 48h, 168h)
JWT_EXPIRATION=24h

# =============================================================================
# Mercado Pago
# Obtener en https://www.mercadopago.com.mx/settings/account/credentials
# Si no se configura, la API usa el mock (útil en desarrollo/testing)
# =============================================================================
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=