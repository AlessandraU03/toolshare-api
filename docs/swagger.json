        "/tools/{id}/photo": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Sube una foto desde la cámara o galería. Enviar como multipart/form-data con el campo \"photo\"",
                "consumes": [
                    "multipart/form-data"
