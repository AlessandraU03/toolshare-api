# =============================================================================
# Configuración del servidor
# =============================================================================
SERVER_PORT=8080

# =============================================================================
# Base de datos PostgreSQL
# Formato: postgres://usuario:contraseña@host:puerto/nombre_db?sslmode=disable
# =============================================================================
DATABASE_URL=postgres://jaffetvicente:Charly1982@localhost:5432/tool_inventory?sslmode=disable
# =============================================================================
# JWT - Clave secreta para firmar tokens
# En producción usa una cadena aleatoria larga (mínimo 32 caracteres)
# =============================================================================
JWT_SECRET=cc9b21dadd7e50b806df5df4ba886314055e5307cab6fb82ec527801ea4fd84ae
# Duración del token JWT (ejemplos: 24h, 48h, 168h)
JWT_EXPIRATION=24h

# =============================================================================
# Pasarela de pagos
# PAYMENT_PROVIDER: "mercadopago" (por defecto) o "stripe"
# Si a la pasarela elegida le falta su clave, se usa un proveedor mock (modo desarrollo)
# =============================================================================
PAYMENT_PROVIDER=mercadopago

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
# Clave pública (safe para embeber en el cliente). Se expone vía GET /api/config
# y la usa Flutter para tokenizar tarjetas directo contra MP (POST /v1/card_tokens)
# sin que los datos completos de la tarjeta pasen por nuestro backend.
MP_PUBLIC_KEY=
# URL pública donde MP enviará las notificaciones del webhook
MP_NOTIFICATION_URL=
# Deep link / URL base para redirigir al frontend tras el pago (success/failure/pending)
MP_BACK_URL=
# Clave secreta de webhooks (Panel de MP > Tus integraciones > Webhooks)
# Usada para validar el header x-signature. Si se deja vacío, no se valida la firma.
MP_WEBHOOK_SECRET=

# --- Stripe ---
# Solo soporta el flujo directo de tarjeta (Authorize/Capture/Cancel), no Checkout/webhook
STRIPE_SECRET_KEY=

# =============================================================================
# Almacenamiento de archivos (fotos de herramientas y tickets)
# Si SUPABASE_URL/SUPABASE_KEY/SUPABASE_BUCKET están las tres presentes, se usa
# Supabase Storage; si falta alguna, se usa disco local (./uploads) como respaldo.
# El bucket debe existir y estar marcado como "Public" en el dashboard de
# Supabase (Storage > tu bucket > Configuration), ya que las URLs devueltas son
# públicas (/storage/v1/object/public/{bucket}/{path}), no firmadas.
# =============================================================================
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=
UPLOADS_DIR=./uploads
UPLOADS_BASE_URL=http://localhost:8080/static

# =============================================================================
# Microservicio de Machine Learning (Python/FastAPI)
# En Windows usa 127.0.0.1 en vez de localhost: "localhost" a veces resuelve
# primero a ::1 (IPv6) y uvicorn por defecto solo escucha en IPv4, lo que causa
# errores intermitentes de "connection refused".
# =============================================================================
ML_SERVICE_URL=http://127.0.0.1:8000
